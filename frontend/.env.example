# Adresse des Backends (Heroku). Wird beim Bauen fest in die App geschrieben.
# In der lokalen Entwicklung leer lassen – dann leitet Vite /api an das lokale Backend weiter.
VITE_API_URL=https://dein-backend.herokuapp.com

