{
  "name": "weihnachtsstrasse-backend",
  "private": true,
  "version": "1.0.0",
  "description": "API für den Adventskalender „Die Weihnachtsstraße“",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "qr": "node --env-file-if-exists=.env scripts/generate-qr.ts"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "oxlint": "^1.93.0",
    "qrcode": "^1.5.4",
    "typescript": "~7.0.2",
    "vitest": "^5.1.0"
  }
}
