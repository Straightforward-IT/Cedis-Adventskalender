# Kopiere diese Datei nach .env und passe die Werte an.

# Geheimnis, aus dem die 24 Türschlüssel (QR-Codes) abgeleitet werden.
# In Produktion Pflicht (mind. 16 Zeichen). Muss beim Erzeugen der QR-Codes
# und auf Heroku identisch sein. Erzeugen z. B. mit: openssl rand -base64 32
QR_SECRET=

# Jahr, in dem der Kalender läuft (1.–24. Dezember dieses Jahres).
CALENDAR_YEAR=2026

# Adresse des Frontends – wird in die QR-Codes geschrieben.
FRONTEND_URL=https://adventskalender.bleck.it

# Erlaubte Ursprünge für Browser-Anfragen (kommagetrennt).
# Ohne Angabe: FRONTEND_URL (+ localhost in der Entwicklung).
# CORS_ORIGINS=https://adventskalender.bleck.it

# Zum Testen: so tun, als wäre heute dieses Datum (JJJJ-MM-TT, Zeitzone Berlin).
# In Produktion nicht setzen!
# DEBUG_DATE=2026-12-05

# Optional: eigene Belohnungstexte pro Tag als JSON, z. B.
# REWARDS_JSON={"1":"In Box 1 wartet etwas Süßes auf dich!","24":"Frohe Weihnachten!"}

# Port für die lokale Entwicklung (Heroku setzt PORT selbst).
# PORT=2412
